# --- Database ---
# For the built-in dev database (`npm run db`, no install needed) use:
#   postgresql://postgres:postgres@localhost:5432/ai_experience_hub?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/ai_experience_hub"

# --- Auth ---
JWT_SECRET="replace_with_a_long_random_string"

# Seed moderator (created by `npx prisma migrate dev` / `npx prisma db seed`)
MODERATOR_EMAIL="moderator@example.com"
MODERATOR_PASSWORD=""

# --- Google OAuth (optional — login works without it) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application). Add the callback URL below to the
# authorized redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# --- Frontend / CORS ---
FRONTEND_URL="http://localhost:3000"
# Comma-separated allowlist, e.g. "http://localhost:3000,https://mysite.com"
CORS_ORIGINS=""

# --- Server ---
PORT=5000
# Set to "production" in deployed environments (disables the request logger,
# tightens CORS warnings)
NODE_ENV=""
